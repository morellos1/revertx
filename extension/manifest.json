{
  "manifest_version": 3,
  "name": "revertX",
  "version": "2.0.1",
  "description": "Restores what X removed: the Media tab's photo grid, the Likes tab on your profile, the photo grid in posts, and Copy link first.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "revertX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "exclude_matches": ["https://x.com/i/deck*"],
      "js": ["dist/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "exclude_matches": ["https://x.com/i/deck*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
